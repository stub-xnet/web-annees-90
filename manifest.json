{
  "manifest_version": 3,
  "name": "Web années 90",
  "version": "2.1",
  "description": "Donne aux sites un look années 90. Clic sur l'icône : Grossier → Léger → Éteint. Clic droit : sons.",
  "permissions": ["storage", "offscreen", "contextMenus"],
  "background": { "service_worker": "fond.js" },
  "action": { "default_title": "Web années 90", "default_icon": "icone.png" },
  "icons": { "128": "icone.png" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "css": ["web90.css"],
    "js": ["web90.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "web_accessible_resources": [{ "resources": ["images/*"], "matches": ["<all_urls>"] }]
}
